---
import { languages, ui, type Lang } from '../i18n/ui';
import { modules } from '../data/topics';
interface Props {
  lang: Lang;
  title: string;
  description: string;
  path?: string;
  /** schema.org objects rendered as JSON-LD */
  jsonLd?: object[];
  noindex?: boolean;
}
const { lang, title, description, path = '', jsonLd = [], noindex = false } = Astro.props;
const t = ui[lang];
const links = [
  { href: '', label: t.navHome },
  { href: '/test', label: t.navTest },
  { href: '/topics', label: t.navTopics },
];
const isCurrent = (href: string) => (href === '' ? path === '' : path === href || path.startsWith(`${href}/`));
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(`/${lang}${path}`);
const ogImage = abs('/og.png');
const langs = Object.keys(languages) as Lang[];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3b5bdb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(`/${l}${path}`)} />)}
        <link rel="alternate" hreflang="x-default" href={abs(`/ru${path}`)} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ui[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <header>
      <nav class="main-nav" aria-label="Main">
        {links.map((l) => (
          <a href={`/${lang}${l.href}`} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <nav class="lang-nav" aria-label="Language">
        {(Object.entries(languages) as [Lang, string][]).map(([code, name]) => (
          <a href={`/${code}${path}`} aria-current={code === lang ? 'page' : undefined}>{name}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="foot-cols">
        <nav class="foot-links" aria-label={t.footTests}>
          <span class="foot-h">{t.footTests}</span>
          <a href={`/${lang}`}>{t.navHome}</a>
          <a href={`/${lang}/test`}>{t.navTest}</a>
        </nav>
        <nav class="foot-links" aria-label={t.navTopics}>
          <span class="foot-h">{t.navTopics}</span>
          {modules.map((m) => <a href={`/${lang}/topics#${m.id}`}>{m.title[lang]}</a>)}
        </nav>
      </div>
      <p class="muted">{t.footFree} <a href="https://tallinn-learning.ee">Tallinn Learning OÜ</a>.</p>
      <p class="muted">© {new Date().getFullYear()} Tallinn Learning OÜ</p>
    </footer>
    <style is:global>
      :root { --bg:#f7f8fa; --fg:#1c2333; --card:#fff; --accent:#3b5bdb; --ok:#2b8a3e; --bad:#c92a2a; --muted:#6b7280; --line:#dfe3ea; }
      @media (prefers-color-scheme: dark) {
        :root { --bg:#12151c; --fg:#e8ebf2; --card:#1b2030; --accent:#7c93ff; --ok:#51cf66; --bad:#ff6b6b; --muted:#9aa3b5; --line:#2b3245; }
      }
      * { box-sizing: border-box; }
      body { display:flex; flex-direction:column; min-height:100dvh; margin:0; background:var(--bg); color:var(--fg); font:16px/1.5 system-ui,sans-serif; }
      header { width:100%; display:flex; flex-wrap:wrap; align-items:center; gap:12px 24px; max-width:920px; margin:0 auto; padding:16px; }
      header nav { display:flex; gap:4px; }
      header nav a { padding:6px 12px; border-radius:8px; color:var(--muted); text-decoration:none; }
      .main-nav { flex-wrap:wrap; gap:4px 20px; }
      .main-nav a { padding:4px 0; border-radius:0; color:var(--fg); border-bottom:2px solid transparent; }
      .main-nav a:hover { color:var(--accent); }
      .main-nav a[aria-current] { color:var(--accent); border-bottom-color:var(--accent); }
      .lang-nav { margin-left:auto; }
      .lang-nav a[aria-current] { background:var(--accent); color:#fff; }
      main { flex:1 0 auto; width:100%; }
      .foot { width:100%; max-width:920px; margin:0 auto; padding:24px 16px 32px; border-top:1px solid var(--line); font-size:.875rem; }
      .foot-cols { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:20px 32px; }
      .foot-links { display:flex; flex-direction:column; gap:6px; }
      .foot-h { color:var(--muted); text-transform:uppercase; letter-spacing:.05em; font-size:.75rem; font-weight:600; }
      .foot a { color:var(--fg); text-decoration:none; }
      .foot a:hover { color:var(--accent); }
      .foot p { margin:16px 0 0; }
      .foot p + p { margin-top:4px; }
      main { max-width:920px; margin:0 auto; padding:0 16px 48px; }
      .card { max-width:640px; margin:0 auto; background:var(--card); border:1px solid var(--line); border-radius:16px; padding:24px; }
      h1 { margin-top:0; }
      button { font:inherit; cursor:pointer; }
      .btn { background:var(--accent); color:#fff; border:0; border-radius:10px; padding:10px 20px; }
      .btn:disabled { opacity:.4; cursor:not-allowed; }
      .options { display:grid; gap:8px; margin:16px 0; padding:0; list-style:none; }
      .opt { width:100%; text-align:left; background:transparent; color:inherit; border:1px solid var(--line); border-radius:10px; padding:10px 14px; }
      .gap { width:100%; box-sizing:border-box; background:transparent; color:inherit; border:1px solid var(--line); border-radius:10px; padding:10px 14px; font:inherit; }
      .gap:focus { outline:none; border-color:var(--accent); box-shadow:0 0 0 2px var(--accent) inset; }
      .opt[aria-pressed="true"] { border-color:var(--accent); box-shadow:0 0 0 2px var(--accent) inset; }
      progress { width:100%; height:8px; accent-color:var(--accent); }
      audio { width:100%; margin:16px 0 0; }
      .prompt { font-size:1.35rem; margin:16px 0 0; }
      .level { font-size:3rem; font-weight:700; color:var(--accent); margin:0; }
      .muted { color:var(--muted); }
      .rev { padding:8px 0; border-top:1px solid var(--line); }
      .ok { color:var(--ok); } .bad { color:var(--bad); }
      [hidden] { display:none !important; }
    </style>
  </body>
</html>
