---
import Base from '../../../layouts/Base.astro';
import { languages, ui, plural, type Lang } from '../../../i18n/ui';
import { listeningTasks } from '../../../data/listening';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = ui[lang];
// Most used tags first, then in order of appearance.
const allTags = listeningTasks.flatMap((x) => x.tags);
const tags = [...new Set(allTags)].sort((a, b) => allTags.filter((x) => x === b).length - allTags.filter((x) => x === a).length);
---
<Base lang={lang} title={`${t.navListening} — ${t.siteName}`} description={t.listeningDesc} path="/listening">
  <div class="head">
    <h1>{t.navListening}</h1>
    <p class="muted">{t.listeningIntro}</p>
  </div>
  <div class="tags" id="tags" role="group">
    <button type="button" class="tag" data-tag="" aria-pressed="true">{t.allTags}</button>
    {tags.map((tag) => <button type="button" class="tag" data-tag={tag} aria-pressed="false" lang="en">#{tag}</button>)}
  </div>
  <div class="grid">
    {listeningTasks.map((x) => (
      <a class="card task" href={`/${lang}/listening/${x.slug}`} data-tags={x.tags.join(' ')}>
        <span class="chip">{x.level}</span>
        <h2>{x.title[lang]}</h2>
        <p class="muted">{plural(lang, x.questions.length, t.questionsCount)}</p>
        <p class="task-tags muted" lang="en">{x.tags.map((tag) => `#${tag}`).join(' ')}</p>
      </a>
    ))}
  </div>
</Base>

<style>
  .head { margin:0 0 24px; }
  .head h1 { margin:0 0 4px; }
  .grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:24px; }
  .task { max-width:none; margin:0; padding:16px; color:inherit; text-decoration:none; transition:border-color .15s, transform .15s; }
  .task:hover, .task:focus-visible { border-color:var(--accent); transform:translateY(-3px); }
  @media (prefers-reduced-motion: reduce) { .task { transition:none; } .task:hover { transform:none; } }
  .chip { background:var(--accent); color:#fff; border-radius:10px; padding:2px 10px; font-weight:700; font-size:.9rem; }
  .task h2 { margin:8px 0 4px; font-size:1.1rem; }
  .task p { margin:0; font-size:.9rem; }
  .task .task-tags { margin-top:6px; font-size:.85rem; }
  .task[hidden] { display:none; }
  .tags { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 24px; }
  .tag { font:inherit; font-size:.9rem; padding:4px 12px; border:1px solid var(--line); border-radius:999px; background:var(--card); color:inherit; cursor:pointer; }
  .tag:hover { border-color:var(--accent); }
  .tag[aria-pressed="true"] { background:var(--accent); border-color:var(--accent); color:#fff; }
</style>

<script>
  // Filter cards by tag; the tag is kept in the URL hash, e.g. /ru/listening#demo.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#tags .tag')];
  const cards = [...document.querySelectorAll<HTMLElement>('.task')];

  function apply(tag: string) {
    if (!buttons.some((b) => b.dataset.tag === tag)) tag = '';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
    cards.forEach((c) => { c.hidden = !!tag && !c.dataset.tags!.split(' ').includes(tag); });
  }

  buttons.forEach((b) => (b.onclick = () => {
    const tag = b.dataset.tag!;
    history.replaceState(null, '', tag ? `#${tag}` : location.pathname);
    apply(tag);
  }));
  apply(decodeURIComponent(location.hash.slice(1)));
</script>
