---
interface Props { alt: string }
const { alt } = Astro.props;
const levels = [
  { id: 'A1', y: 70, on: false, line: 120 },
  { id: 'A2', y: 140, on: false, line: 150 },
  { id: 'B1', y: 210, on: true, line: 180 },
];
---
<svg viewBox="0 0 360 340" role="img" aria-label={alt} xmlns="http://www.w3.org/2000/svg">
  <ellipse cx="180" cy="322" rx="140" ry="10" fill="currentColor" opacity=".08" />
  <!-- picker card -->
  <rect x="20" y="16" width="320" height="290" rx="22" fill="var(--card)" stroke="var(--line)" stroke-width="2" />
  <rect x="44" y="40" width="110" height="10" rx="5" fill="currentColor" opacity=".25" />
  <circle cx="312" cy="45" r="5" fill="var(--accent)" opacity=".5" />
  <circle cx="296" cy="45" r="5" fill="var(--accent)" opacity=".3" />
  {levels.map((l) => (
    <g>
      <rect x="40" y={l.y} width="280" height="56" rx="14"
        fill={l.on ? 'var(--accent)' : 'none'} fill-opacity={l.on ? '.12' : '0'}
        stroke={l.on ? 'var(--accent)' : 'var(--line)'} stroke-width={l.on ? 3 : 2} />
      <rect x="54" y={l.y + 10} width="52" height="36" rx="10" fill="var(--accent)" opacity={l.on ? 1 : 0.35} />
      <text x="80" y={l.y + 35} text-anchor="middle" font-family="system-ui,sans-serif" font-weight="700" font-size="20" fill="#fff">{l.id}</text>
      <rect x="122" y={l.y + 15} width={l.line} height="8" rx="4" fill="currentColor" opacity=".3" />
      <rect x="122" y={l.y + 31} width={l.line * 0.6} height="8" rx="4" fill="currentColor" opacity=".15" />
      {l.on ? (
        <g>
          <circle cx="296" cy={l.y + 28} r="13" fill="var(--accent)" />
          <path d={`M289 ${l.y + 28} l5 5 l9 -10`} fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      ) : (
        <circle cx="296" cy={l.y + 28} r="12" fill="none" stroke="var(--line)" stroke-width="2" />
      )}
    </g>
  ))}
  <!-- cursor -->
  <g transform="translate(250 246)">
    <path d="M0 0 L0 30 L8 23 L14 36 L20 33 L14 21 L25 21 Z" fill="var(--fg)" stroke="var(--card)" stroke-width="2" stroke-linejoin="round" />
  </g>
</svg>
